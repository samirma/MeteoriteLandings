<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup configuration (replaces the legacy full-backup descriptor).

  The meteorite database is a copy of a read-only asset that is recreated on first launch, so
  backing up ~5 MB of it would waste the user's backup quota for nothing. Everything else —
  notably the small DataStore file holding the theme preference — is backed up by default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="meteorites_v2.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="meteorites_v2.db" />
    </device-transfer>
</data-extraction-rules>
