<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Observing connectivity through ConnectivityManager. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Foreground, one-shot location used to sort meteorites by distance. Both are optional:
         the app falls back to alphabetical ordering when they are denied. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <application
        android:name=".MeteoriteApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeteoriteLandings">

        <!-- No android:label: it would repeat the application label verbatim.
             enableOnBackInvokedCallback is honoured from API 33; on 30-32 it is inert. -->
        <activity
            android:name="com.antonio.samir.meteoritelandingsspots.features.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MeteoriteLandings.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MeteoriteApplication implements Configuration.Provider to install HiltWorkerFactory,
             so WorkManager must not self-initialise with the default factory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Supplied by the untracked res/values/secret.xml; see README. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/key_map" />

    </application>

</manifest>
